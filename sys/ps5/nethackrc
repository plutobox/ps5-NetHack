# NetHack options for the PS5 port. The payload reads them from
# /data/NetHack/.nethackrc, which you can edit; the native title ships them
# read-only in /app0.
OPTIONS=windowtype:curses
OPTIONS=color,number_pad:0,autopickup,pickup_types:$?!/="+
OPTIONS=hilite_pet,hilite_pile,lit_corridor,showexp,time
OPTIONS=menucolors,statushilites:10
OPTIONS=perm_invent,msg_window:reversed
OPTIONS=!mail,!splash_screen
OPTIONS=symset:DECgraphics
# Controller-friendly: '#' opens a menu of commands, no tutorial question,
# and ^Q (the native title's Cross and Square on the map) shows the actions
# for where you stand.
OPTIONS=extmenu,!tutorial
BIND=^Q:herecmdmenu
# "What do you want to eat?" and the like open a menu of the likely items
# straight away, rather than asking for an inventory letter.
OPTIONS=force_invmenu
# Keep the files a game needs to be recovered: closing the native title
# from the home screen ends it without saving.  idlecheckpoint brings them
# up to date whenever the game has waited ten seconds for a command, so a
# recovered game resumes where it was left, even one restored from a save.
OPTIONS=checkpoint,idlecheckpoint
